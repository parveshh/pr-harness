{
  "name": "local-reviewer",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron .",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,html,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,css,html,json,yml}\"",
    "typecheck": "tsc -p client --noEmit && tsc -p desktop --noEmit",
    "test": "node --import tsx --test desktop/*.test.ts",
    "build": "npm run typecheck && electron-vite build",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "lowlight": "^3.3.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.24.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  },
  "productName": "Local Reviewer",
  "main": "dist/main/main.js",
  "description": "A desktop workspace for reviewing GitHub pull requests.",
  "author": "parveshh"
}
